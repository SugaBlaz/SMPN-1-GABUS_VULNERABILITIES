        panel.querySelector("#suga-menu-dropdown");

    // ============================================================
    // Logging
    // ============================================================

    function log(message) {
        const line =
            document.createElement("div");

        line.textContent =
            `> ${message}`;

        logBox.prepend(line);

        while (logBox.children.length > 100) {
            logBox.lastElementChild.remove();
        }

        // Keep newest event at the top.
        logBox.scrollTop = 0;
    }

    // ============================================================
    // Menu selector
    // ============================================================

    function buildMenuSelector() {
        menuDropdown.innerHTML = "";

        MENU_DEFINITIONS.forEach(menu => {
            const label =
                document.createElement("label");

            label.className =
                "suga-menu-item";

            const checkbox =
                document.createElement("input");

            checkbox.type = "checkbox";
            checkbox.value = menu.id;
            checkbox.dataset.menuId =
                menu.id;

            const text =
                document.createElement("span");

            text.textContent =
                menu.label;

            label.appendChild(checkbox);
            label.appendChild(text);

            menuDropdown.appendChild(label);
        });

        updateMenuButton();
    }

    function getSelectedMenus() {
        return [
            ...menuDropdown.querySelectorAll(
                'input[type="checkbox"]:checked'
            )
        ].map(
            checkbox =>
                checkbox.dataset.menuId
        );
    }

    function setSelectedMenus(menus) {
        const selected =
            new Set(
                Array.isArray(menus)
                    ? menus
                    : []
            );

        menuDropdown
            .querySelectorAll(
                'input[type="checkbox"]'
            )
            .forEach(checkbox => {
                checkbox.checked =
                    selected.has(
                        checkbox.dataset.menuId
                    );
            });

        updateMenuButton();
    }

    function updateMenuButton() {
        const selected =
            getSelectedMenus();

        if (selected.length === 0) {
            menuButton.textContent =
                "NONE ▾";

            return;
        }

        if (
            selected.length ===
            MENU_DEFINITIONS.length
        ) {
            menuButton.textContent =
                "ALL MENUS ▾";

            return;
        }

        const names =
            MENU_DEFINITIONS
                .filter(menu =>
                    selected.includes(
                        menu.id
                    )
                )
                .map(menu =>
                    menu.label
                );

        let text =
            names.join(", ");

        if (text.length > 20) {
            text =
                `${selected.length} SELECTED`;
        }

        menuButton.textContent =
            `${text} ▾`;
    }

    // ============================================================
    // Refresh navigation
    // ============================================================

    function refreshMenus() {
        MENU_DEFINITIONS.forEach(menu => {
            const element =
                document.getElementById(
                    "nav-" + menu.id
                );

            if (element) {
                element.style.display =
                    "none";
            }
        });

        const allowed =
            Array.isArray(
                window.allowedMenus
            )
                ? window.allowedMenus
                : [];

        allowed.forEach(menuId => {
            const element =
                document.getElementById(
                    "nav-" + menuId
                );

            if (element) {
                element.style.display =
                    "flex";
            }
        });
    }

    // ============================================================
    // Refresh displayed username
    // ============================================================

    function refreshDisplayedUsername(
        oldUsername,
        newUsername
    ) {
        if (!oldUsername) {
            return;
        }

        const oldValue =
            String(oldUsername)
                .trim()
                .toLowerCase();

        document
            .querySelectorAll("*")
            .forEach(element => {

                if (element === panel) {
                    return;
                }

                if (panel.contains(element)) {
                    return;
                }

                if (
                    element.children.length !== 0
                ) {
                    return;
                }

                const text =
                    element.textContent
                        .trim()
                        .toLowerCase();

                if (text === oldValue) {
                    element.textContent =
                        newUsername;
                }
            });
    }

    // ============================================================
    // Apply spoof
    // ============================================================

    function applySpoof(
        targetUsername,
        selectedMenus
    ) {
        if (!window.currentUser) {
            log(
                "[!] APPLY BLOCKED: NOT LOGGED IN"
            );

            return false;
        }

        const target =
            String(
                targetUsername ?? ""
            ).trim();

        const menus =
            Array.isArray(selectedMenus)
                ? selectedMenus
                : getSelectedMenus();

        if (!target) {
            log(
                "[!] APPLY BLOCKED: EMPTY USERNAME"
            );

            return false;
        }

        const validMenuIds =
            new Set(
                MENU_DEFINITIONS.map(
                    menu => menu.id
                )
            );

        const cleanMenus =
            menus.filter(
                menu =>
                    validMenuIds.has(menu)
            );

        const original =
            window.currentUser;

        // --------------------------------------------------------
        // Client-side username
        // --------------------------------------------------------

        window.currentUser =
            target;

        // --------------------------------------------------------
        // Client-side menus
        // --------------------------------------------------------

        window.allowedMenus =
            cleanMenus;

        // --------------------------------------------------------
        // Refresh UI
        // --------------------------------------------------------

        refreshMenus();

        refreshDisplayedUsername(
            original,
            target
        );

        // --------------------------------------------------------
        // Log
        // --------------------------------------------------------

        console.log(
            "[SUGA//AUTH] Original:",
            original
        );

        console.log(
            "[SUGA//AUTH] Spoofed:",
            target
        );

        console.log(
            "[SUGA//AUTH] Menus:",
            cleanMenus
        );

        log(
            `[+] USER: ${original} → ${target}`
        );

        log(
            `[+] MENUS: ${
                cleanMenus.length
                    ? cleanMenus.join(", ")
                    : "NONE"
            }`
        );

        updateUI();

        return true;
    }

    // ============================================================
    // Login handlers
    // ============================================================

    function handleLogin(user) {
        const loggedInAs =
            String(user || "").trim();

        console.log(
            "[*] Login detected:",
            loggedInAs
        );

        log(
            `[*] LOGIN: ${loggedInAs}`
        );

        const target =
            spoofUserInput.value.trim();

        const menus =
            getSelectedMenus();

        if (!target) {
            log(
                "[!] No spoof username configured"
            );

            if (menus.length > 0) {
                window.allowedMenus =
                    menus;

                refreshMenus();

                log(
                    `[+] MENUS APPLIED: ${menus.join(", ")}`
                );
            }

            updateUI();

            return;
        }

        applySpoof(
            target,
            menus
        );
    }

    function AutoLogin(e) {
        e.stopPropagation();
    
        const usernameInput =
            document.getElementById("uName");
    
        const passwordInput =
            document.getElementById("uPass");
    
        if (!usernameInput || !passwordInput) {
            log("[!] Login fields not found");
            return;
        }
    
        usernameInput.value = "publik";
        passwordInput.value = "publik123";
    
        usernameInput.dispatchEvent(
            new Event("input", { bubbles: true })
        );
    
        passwordInput.dispatchEvent(
            new Event("input", { bubbles: true })
        );
    
        log("[*] TEST LOGIN: publik");
    
        if (typeof window.prosesLogin === "function") {
            window.prosesLogin();
        } else {
            log("[!] prosesLogin() not available");
        }
    }

    // ============================================================
    // Watcher
    // ============================================================

    function check() {
        if (!enabled) {
            return;
        }

        const current =
            window.currentUser || null;

        if (current === lastUser) {
            return;
        }

        // --------------------------------------------------------
        // Logout
        // --------------------------------------------------------

        if (lastUser && !current) {
            log(
                "[*] LOGOUT DETECTED"
            );

            stateLabel.textContent =
                "WAITING";

            lastUser = null;

            updateUI();

            return;
        }

        // --------------------------------------------------------
        // Login
        // --------------------------------------------------------

        if (!lastUser && current) {
            handleLogin(current);

            lastUser =
                window.currentUser || null;

            updateUI();

            return;
        }

        // --------------------------------------------------------
        // Other identity change
        // --------------------------------------------------------

        lastUser =
            window.currentUser || null;

        updateUI();
    }

    // ============================================================
    // Start watcher
    // ============================================================

    function startWatcher() {
        if (enabled) {
            return;
        }

        enabled = true;

        log(
            "[+] WATCHER ENABLED"
        );

        timer =
            setInterval(
                check,
                500
            );

        check();

        updateUI();
    }

    // ============================================================
    // Stop watcher
    // ============================================================

    function stopWatcher() {
        enabled = false;

        if (timer !== null) {
            clearInterval(timer);
            timer = null;
        }

        log(
            "[+] WATCHER DISABLED"
        );

        updateUI();
    }

    // ============================================================
    // UI update
    // ============================================================

    function updateUI() {
        const current =
            window.currentUser || null;

        userLabel.textContent =
            current || "---";

        // Always editable.
        spoofUserInput.disabled = false;

        updateMenuButton();

        if (enabled) {
            indicator.textContent =
                "● ON";

            indicator.className =
                "suga-online";

            toggle.textContent =
                "ON";

            toggle.className =
                "suga-online";

            stateLabel.textContent =
                "MONITORING";
        } else {
            indicator.textContent =
                "● OFF";

            indicator.className =
                "suga-offline";

            toggle.textContent =
                "OFF";

            toggle.className =
                "suga-offline";

            stateLabel.textContent =
                "STANDBY";
        }
    }

    // ============================================================
    // Watcher button
    // ============================================================

    function onToggleClick(e) {
        e.stopPropagation();

        if (enabled) {
            stopWatcher();
        } else {
            startWatcher();
        }
    }

    toggle.addEventListener(
        "click",
        onToggleClick
    );

    // ============================================================
    // Username input
    // ============================================================

    function onSpoofUserKeyDown(e) {
        if (e.key !== "Enter") {
            return;
        }

        e.preventDefault();

        if (!window.currentUser) {
            log(
                "[!] Cannot apply: NOT LOGGED IN"
            );

            return;
        }

        applySpoof(
            spoofUserInput.value,
            getSelectedMenus()
        );
    }

    spoofUserInput.addEventListener(
        "keydown",
        onSpoofUserKeyDown
    );

    // --------------------------------------------------------
    // Login
    // --------------------------------------------------------

    loginButton.addEventListener(
        "click",
        AutoLogin
    );

    // ============================================================
    // Menu dropdown
    // ============================================================

    function onMenuButtonClick(e) {
        e.stopPropagation();

        menuDropdown.classList.toggle(
            "suga-open"
        );
    }

    menuButton.addEventListener(
        "click",
        onMenuButtonClick
    );

    function onMenuChange(e) {
        if (
            !e.target.matches(
                'input[type="checkbox"]'
            )
        ) {
            return;
        }

        updateMenuButton();

        const selected =
            getSelectedMenus();

        // Apply immediately when already logged in.
        if (window.currentUser) {
            window.allowedMenus =
                selected;

            refreshMenus();

            log(
                `[+] MENUS UPDATED: ${
                    selected.length
                        ? selected.join(", ")
                        : "NONE"
                }`
            );

            updateUI();
        }
    }

    menuDropdown.addEventListener(
        "change",
        onMenuChange
    );

    // ============================================================
    // Outside click
    // ============================================================

    function onDocumentClick(e) {
        if (
            !menuDropdown.contains(e.target) &&
            e.target !== menuButton
        ) {
            menuDropdown.classList.remove(
                "suga-open"
            );
        }
    }

    document.addEventListener(
        "click",
        onDocumentClick
    );

    // ============================================================
    // Dragging
    // ============================================================

    function movePanel() {
        raf = null;

        if (!dragging) {
            return;
        }

        panel.style.left =
            `${pendingX - offsetX}px`;

        panel.style.top =
            `${pendingY - offsetY}px`;
    }

    function onPointerDown(e) {
        if (
            e.target === toggle ||
            e.target === close ||
            e.target === spoofUserInput ||
            e.target === menuButton ||
            e.target.closest("button") ||
            e.target.closest("input") ||
            e.target.closest(
                ".suga-menu-wrapper"
            )
        ) {
            return;
        }

        dragging = true;

        pointerId =
            e.pointerId;

        const rect =
            panel.getBoundingClientRect();

        offsetX =
            e.clientX - rect.left;

        offsetY =
            e.clientY - rect.top;

        panel.style.right =
            "auto";

        head.setPointerCapture(
            pointerId
        );
    }

    function onPointerMove(e) {
        if (
            !dragging ||
            e.pointerId !== pointerId
        ) {
            return;
        }

        pendingX =
            e.clientX;

        pendingY =
            e.clientY;

        if (raf === null) {
            raf =
                requestAnimationFrame(
                    movePanel
                );
        }
    }

    function onPointerUp(e) {
        if (
            e.pointerId !== pointerId
        ) {
            return;
        }

        dragging = false;
        pointerId = null;

        if (raf !== null) {
            cancelAnimationFrame(raf);
            raf = null;
        }
    }

    head.addEventListener(
        "pointerdown",
        onPointerDown
    );

    head.addEventListener(
        "pointermove",
        onPointerMove
    );

    head.addEventListener(
        "pointerup",
        onPointerUp
    );

    head.addEventListener(
        "pointercancel",
        onPointerUp
    );

    // ============================================================
    // Destroy
    // ============================================================

    function destroy() {
        enabled = false;

        if (timer !== null) {
            clearInterval(timer);
            timer = null;
        }

        if (raf !== null) {
            cancelAnimationFrame(raf);
            raf = null;
        }

        toggle.removeEventListener(
            "click",
            onToggleClick
        );

        spoofUserInput.removeEventListener(
            "keydown",
            onSpoofUserKeyDown
        );

        menuButton.removeEventListener(
            "click",
            onMenuButtonClick
        );

        menuDropdown.removeEventListener(
            "change",
            onMenuChange
        );

        document.removeEventListener(
            "click",
            onDocumentClick
        );

        head.removeEventListener(
            "pointerdown",
            onPointerDown
        );

        head.removeEventListener(
            "pointermove",
            onPointerMove
        );

        head.removeEventListener(
            "pointerup",
            onPointerUp
        );

        head.removeEventListener(
            "pointercancel",
            onPointerUp
        );

        loginButton.removeEventListener(
            "click",
            loginAsPublik
        );

        panel.remove();
        style.remove();

        delete window.__sugaAuth;

        console.log(
            "[SUGA//AUTH] Console terminated."
        );
    }

    // ============================================================
    // Close
    // ============================================================

    close.addEventListener(
        "click",
        e => {
            e.stopPropagation();

            console.log(
                "[*] Terminating..."
            );

            destroy();
        }
    );

    // ============================================================
    // Global controller
    // ============================================================

    window.__sugaAuth = {
        start: startWatcher,

        stop: stopWatcher,

        destroy,

        spoof(username) {
            return applySpoof(
                username,
                getSelectedMenus()
            );
        },

        setMenus(menus) {
            if (!Array.isArray(menus)) {
                console.warn(
                    "[SUGA//AUTH] setMenus expects an array."
                );

                return false;
            }

            setSelectedMenus(menus);

            if (window.currentUser) {
                window.allowedMenus =
                    getSelectedMenus();

                refreshMenus();

                log(
                    `[+] MENUS UPDATED: ${
                        window.allowedMenus.length
                            ? window.allowedMenus.join(", ")
                            : "NONE"
                    }`
                );

                updateUI();
            }

            return true;
        },

        status() {
            return {
                version: VERSION,

                enabled,

                loggedIn:
                    Boolean(
                        window.currentUser
                    ),

                currentUser:
                    window.currentUser || null,

                spoofTarget:
                    spoofUserInput.value.trim() ||
                    null,

                selectedMenus:
                    getSelectedMenus(),

                allowedMenus:
                    Array.isArray(
                        window.allowedMenus
                    )
                        ? [
                            ...window.allowedMenus
                        ]
                        : []
            };
        }
    };

    // ============================================================
    // Initialize
    // ============================================================

    buildMenuSelector();
    updateUI();

    console.log(
        `%c[SUGA'S SPOOFER] ${VERSION} initialized.`,
        "color:#00ff66;font-weight:bold"
    );

})();
